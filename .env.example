# ─── Flask ───────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# ─── Database ─────────────────────────────────────────────
# Development: SQLite
DATABASE_URL=sqlite:///./store_up_dev.db

# Production: PostgreSQL (override in prod env)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/store_up

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES=3600       # seconds (1h)
JWT_REFRESH_TOKEN_EXPIRES=604800    # seconds (7d)

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT=200 per hour
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

# ─── CORS / Domain Restriction ────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880          # 5MB in bytes

# ─── Superuser Bootstrap (used by `flask bootstrap-superuser`) ──
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-immediately
